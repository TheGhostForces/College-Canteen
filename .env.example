# --- База данных ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=canteen
# Хост БД нужен только при запуске приложения без Docker; в docker-compose подставляется "postgres"
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Безопасность ---
# Минимум 32 символа: openssl rand -hex 32
SECRET_KEY=
# Срок жизни сессии (дней)
ACCESS_TOKEN_TTL_DAYS=30
# При локальной разработке по http поставьте false (cookie с флагом Secure иначе не сохранится)
COOKIE_SECURE=true

# --- Почта (коды входа отправляются через Resend: https://resend.com) ---
# Только локально: MAIL_BACKEND=console (вместо писем коды выводятся в лог!)
# В продакшене используйте resend; console раскрывает коды в логах.
MAIL_BACKEND=resend
RESEND_API_KEY=
MAIL_FROM=

# --- Прочее ---
# Swagger на /docs; в продакшене оставляйте false
ENABLE_DOCS=false
# Префикс внешнего API за reverse proxy (для корректной работы Swagger)
# API_ROOT_PATH=/api
# Часовой пояс колледжа (сроки отмены заказа, смена суток)
# TIMEZONE=Europe/Moscow
# Разрешённые источники для CORS (JSON-массив)
# CORS_ORIGINS=["https://voscollege.ru","https://www.voscollege.ru"]
